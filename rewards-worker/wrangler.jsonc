{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crackpacks-rewards",
  "main": "src/index.js",
  "compatibility_date": "2026-07-16",
  "routes": [{ "pattern": "rewards-api.crackpacks.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "crackpacks-rewards", "database_id": "8b0edc0e-4766-47e0-89e0-2dcf1f46ce1b" }],
  "r2_buckets": [{ "binding": "SHOW_MEDIA", "bucket_name": "crackpacks-show-media" }],
  "send_email": [{ "name": "REWARDS_EMAIL", "allowed_sender_addresses": ["rewards@crackpacks.com", "orders@crackpacks.com", "alerts@crackpacks.com", "support@crackpacks.com", "hello@crackpacks.com", "gig@crackpacks.com"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://crackpacks.com,https://www.crackpacks.com,http://localhost:8080,http://127.0.0.1:8080",
    "CLOUDFLARE_ACCOUNT_ID": "198a4ebd4ac3a23957f8d0431c273228",
    "CLOUDFLARE_STREAM_CUSTOMER_CODE": "customer-pb8134a54cjpgbat.cloudflarestream.com",
    "SITE_URL": "https://crackpacks.com",
    "MASTER_EMAILS": "robertreese@faytsystems.com",
    "IDENTITY_MODE": "internal",
    "RP_ID": "crackpacks.com",
    "RP_NAME": "Crack Packs",
    "DISCOUNT_PREFIX": "CRACK",
    "DISCOUNT_PERCENT": "10",
    "STORE_BASE_CURRENCY": "USD",
    "STORE_COMING_SOON": "true",
    "STORE_CHECKOUT_ENABLED": "false",
    "LIVE_AUCTIONS_ENABLED": "false",
    "INTERNATIONAL_INCOTERM": "DAP"
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "observability": { "enabled": true }
}
